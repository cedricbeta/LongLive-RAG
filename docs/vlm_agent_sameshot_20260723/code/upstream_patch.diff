+    def _snapshot_kv_state(self):
+        """Snapshot the causal KV cache + CPU memory pool so a block can be
+        regenerated from an identical state (restore-and-retry)."""
+        snap = []
+        for c in self.kv_cache1:
+            snap.append({
+                "k": c["k"].clone(),
+                "v": c["v"].clone(),
+                "global_end": c["global_end_index"].item(),
+                "local_end": c["local_end_index"].item(),
+                "n_cpu_k": len(c.get("cpu_k_frames", [])),
+                "n_cpu_v": len(c.get("cpu_v_frames", [])),
+            })
+        return snap
+
+    def _restore_kv_state(self, snap):
+        for c, s in zip(self.kv_cache1, snap):
+            c["k"].copy_(s["k"])
+            c["v"].copy_(s["v"])
+            c["global_end_index"].fill_(s["global_end"])
+            c["local_end_index"].fill_(s["local_end"])
+            del c["cpu_k_frames"][s["n_cpu_k"]:]
+            del c["cpu_v_frames"][s["n_cpu_v"]:]
+
